{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun dist/main.js",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "docker compose stop app-1 app-2 app-3 2>/dev/null || true",
    "test": "bun test --parallel=1 --max-concurrency=1 src && for f in tests/integration/*.spec.ts; do bun test --parallel=1 --max-concurrency=1 --timeout=60000 \"$f\" || exit 1; done && bun test --parallel=1 --max-concurrency=1 scripts",
    "posttest": "docker compose start app-1 app-2 app-3 2>/dev/null || true",
    "pretest:distributed": "docker compose stop app-1 app-2 app-3 2>/dev/null || true",
    "test:distributed": "bun test --parallel=1 --max-concurrency=1 --timeout=180000 tests/distributed/three-instance.spec.ts",
    "posttest:distributed": "docker compose start app-1 app-2 app-3 2>/dev/null || true",
    "migrate": "bun run scripts/migrate.ts",
    "readiness": "bun run scripts/readiness.ts",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "clean": "rm -rf dist node_modules bun.lock bun.lockb .bun"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.668.0",
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.14",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/terminus": "^10.2.3",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@types/bun": "^1.1.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
