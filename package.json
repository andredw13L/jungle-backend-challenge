{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun dist/main.js",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "readiness": "bun run scripts/readiness.ts",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "clean": "rm -rf dist node_modules bun.lock bun.lockb .bun"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.668.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/terminus": "^10.2.3",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@types/bun": "^1.1.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}