# Listening port for this NestJS instance. The README mandates three processes
# on 3101, 3102 and 3103 sharing one codebase; each invocation picks one.
PORT=3101

# PostgreSQL 18 — uuidv7() is provided natively. Slice 3 creates the schema.
DATABASE_URL=postgres://wagering:wagering@localhost:5544/wagering
DATABASE_SSL=false

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# FIFO queue URLs — created by scripts/readiness.ts
QUEUE_COMMAND=wager-transactions.fifo
QUEUE_COMMAND_DLQ=wager-transactions-dlq.fifo
QUEUE_EVENTS=wager-events.fifo

# SQS poll sizing (used in slice 7)
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_SECONDS=60

# Pending reference worker retries (used in slice 6)
RETRY_MAX_ATTEMPTS=8
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=60

# Logging / shutdown
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000